# Banco de dados (o docker-compose da raiz sobe exatamente esta instancia)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teams_tasks?schema=public"

# Servidor HTTP
PORT=3333
NODE_ENV=development

# Observabilidade
LOG_LEVEL=info

# Origens permitidas (separadas por virgula). '*' libera todas - use apenas em dev.
CORS_ORIGIN=*
