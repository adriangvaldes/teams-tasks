{
  "name": "teams-tasks",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo: API REST (Express + arquitetura hexagonal) e app mobile (Expo) para gestao de Times e Tarefas",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "setup": "pnpm install && pnpm db:up && pnpm db:migrate && pnpm seed",
    "start": "pnpm --filter @teams-tasks/api start",
    "dev": "pnpm --filter @teams-tasks/api dev",
    "dev:api": "pnpm --filter @teams-tasks/api dev",
    "dev:mobile": "pnpm --filter @teams-tasks/mobile start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:all": "pnpm --filter @teams-tasks/api test:all && pnpm --filter @teams-tasks/mobile test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check apps packages",
    "format": "biome check --write apps packages",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "pnpm --filter @teams-tasks/api db:migrate",
    "seed": "pnpm --filter @teams-tasks/api seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9"
  }
}
