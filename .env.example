# Porta do HOST em que o PostgreSQL do docker-compose sera publicado.
# Deixe em 5432 (padrao) se voce nao tem PostgreSQL instalado na maquina.
# Se tiver, use outra porta - o Docker no Windows NAO falha visivelmente na
# colisao: ele reporta a porta como publicada, mas quem atende localhost:5432
# continua sendo o servidor nativo, e voce acaba usando o banco errado.
POSTGRES_PORT=5432
